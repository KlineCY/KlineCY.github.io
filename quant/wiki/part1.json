  "terms": [
    {
      "id": "market-001",
      "category_id": "market",
      "title": "OHLCV",
      "english": "Open High Low Close Volume",
      "definition": "开盘价、最高价、最低价、收盘价、成交量组成行情Bar，广泛用于策略研究。\n\nOHLCV是一段时间内成交价格与总成交量的压缩记录。无法从一个Bar还原逐笔顺序、买卖方向与真实成交队列。",
      "example": "用20日收盘价计算均线。\n\n数值例题：成交价100、102、99、101且成交股数5、2、3、4，则O=100、H=102、L=99、C=101、V=14。",
      "pitfall": "不能复原逐笔成交顺序。\n\n研究注意：同一Bar的最高和最低价不能证明止盈止损哪个先被触发。",
      "formula": "O=P_first，H=max P_i，L=min P_i，C=P_last，V=Σq_i",
      "level": "初级",
      "reference_url": "https://www.nasdaq.com/market-activity",
      "related_ids": [
        "market-002",
        "market-003"
      ]
    },
    {
      "id": "market-002",
      "category_id": "market",
      "title": "Tick数据",
      "english": "Tick Data",
      "definition": "逐笔成交或报价事件记录，不是固定时长的K线。\n\nTick可代表成交、报价更新或盘口事件，事件类型不等同实际成交笔数；需要交易所时间、接收时间、序列号和消息类型。",
      "example": "研究大单成交后下一秒价格变化。\n\n数值例题：买一价由100.00变为99.99而无成交，仍会生成行情事件；错误地视为一笔成交将夸大交易活跃度。",
      "pitfall": "Tick不等于完整Level 3委托事件。\n\n研究注意：不能使用接收时间代替交易所事件时间解释跨市场因果领先。",
      "formula": "event_i=(timestamp,type,price,quantity)",
      "level": "中级",
      "reference_url": "https://www.nasdaq.com/market-activity",
      "related_ids": [
        "market-001",
        "market-003",
        "market-004"
      ]
    },
