    {
      "id": "backtest-004",
      "category_id": "backtest",
      "title": "前视偏差",
      "english": "Look-Ahead Bias",
      "definition": "历史决策误用该时点尚未公开或无法交易的信息。",
      "example": "使用财报尚未发布的季度EPS买股票。",
      "pitfall": "财报所属季度不等于披露日期。",
      "formula": "",
      "level": "初级",
      "reference_url": "https://zipline.ml4trading.io/",
