    {
      "id": "backtest-001",
      "category_id": "backtest",
      "title": "回测",
      "english": "Backtesting",
      "definition": "基于历史可用数据模拟策略信号、交易和持仓，评估过去表现与风险。",
      "example": "对2020—2025年ETF趋势策略含成本回测。",
      "pitfall": "历史表现不保证未来盈利。",
      "formula": "",
      "level": "初级",
      "reference_url": "https://zipline.ml4trading.io/",
      "related_ids": [
        "backtest-002",
        "backtest-003",
        "backtest-004",
        "backtest-005",
        "execution-017"
      ]
    },
    {
      "id": "backtest-002",
      "category_id": "backtest",
      "title": "样本内",
      "english": "In-Sample",
      "definition": "用于拟合模型、选择特征和开发策略的数据。",
      "example": "在2020—2022年调均线参数。",
      "pitfall": "样本内最优不代表独立泛化。",
      "formula": "",
      "level": "初级",
      "reference_url": "https://zipline.ml4trading.io/",
      "related_ids": [
