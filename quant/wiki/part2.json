    },
    {
      "id": "backtest-005",
      "category_id": "backtest",
      "title": "幸存者偏差",
      "english": "Survivorship Bias",
      "definition": "回测只用如今仍存续的证券而漏掉退市或差表现资产。",
      "example": "用今天的ETF名单回测十年前。",
      "pitfall": "需要可投资历史全集和退市数据。",
      "formula": "",
      "level": "初级",
      "reference_url": "https://zipline.ml4trading.io/",
