    },
    {
      "id": "backtest-003",
      "category_id": "backtest",
      "title": "样本外",
      "english": "Out-of-Sample",
      "definition": "独立于策略拟合与模型选择的数据区间，用于最终泛化评价。",
      "example": "用2023—2025年固定参数检验。",
      "pitfall": "反复查看测试集再修改策略会破坏独立性。",
      "formula": "",
      "level": "初级",
      "reference_url": "https://zipline.ml4trading.io/",
